# --- Apelles monorepo ---

# secrets — never commit, this repo is public
.env
.env.*
!.env.example

# Rust workspace build output
/target/
**/target/

# node
node_modules/
**/node_modules/
dist/
dist-ssr/
**/dist/
*.local
.turbo/

# the app (vendored RapidRAW fork, D-039/D-040)
app/src-tauri/gen/*
!app/src-tauri/gen/android/
app/src-tauri/gen/android/app/src/main/assets/
app/src-tauri/libs/
app/src-tauri/resources/libonnxruntime.so
app/src-tauri/resources/libonnxruntime.dylib
app/src-tauri/resources/onnxruntime.dll
app/bench/out/
**/keystore.properties
**/keystore.jks
**/key.properties

# the ONE shared environment both Python sidecars run from (D-314). The lock
# file next to it IS committed — it is what makes the environment reproducible.
ai-env/.venv/
ai-env/__pycache__/

# python ai sidecar
ai/.venv/
ai/__pycache__/
ai/**/__pycache__/
ai/models/
ai/vendor/**/checkpoints/
*.pyc

# python media-understanding sidecar (D-184). Still its own PROCESS, but since
# D-314 no longer its own venv — these two entries only cover a deliberate
# per-sidecar venv, which still wins over ai-env/.venv if someone creates one.
ai-media/.venv/
ai-media/__pycache__/

# mcp server
mcp/target/
mcp/.venv/
mcp/__pycache__/
mcp/**/__pycache__/

# eval
eval/results/*.result.png

# scratch / media
scratch/*
!scratch/README.md
*.mp4
*.mov
*.exr
*.dpx
*.cube
!docs/**/*.cube
.DS_Store

# logs
*.log
logs/

# recoverable pre-monorepo fork history — archive it, then delete
engine-history.bundle

# D-315 — the pinned uv binary, fetched + hash-verified by app/src-tauri/build.rs
app/src-tauri/binaries/
# D-315 — ai-env inputs staged into the bundle by build.rs (generated copies)
app/src-tauri/resources/ai-env/
# D-390 — the Python sidecars' sources, staged into the bundle by build.rs (release builds)
app/src-tauri/resources/sidecars/
