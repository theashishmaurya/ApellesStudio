# --- Apelles monorepo ---

# secrets — never commit, this repo is public
.env
.env.*
!.env.example

# Rust workspace build output
/target/
**/target/

# node
node_modules/
**/node_modules/
dist/
dist-ssr/
**/dist/
*.local
.turbo/

# the app (vendored RapidRAW fork, D-039/D-040)
app/src-tauri/gen/*
!app/src-tauri/gen/android/
app/src-tauri/gen/android/app/src/main/assets/
app/src-tauri/libs/
app/src-tauri/resources/libonnxruntime.so
app/src-tauri/resources/libonnxruntime.dylib
app/src-tauri/resources/onnxruntime.dll
app/bench/out/
**/keystore.properties
**/keystore.jks
**/key.properties

# python ai sidecar
ai/.venv/
ai/__pycache__/
ai/**/__pycache__/
ai/models/
ai/vendor/**/checkpoints/
*.pyc

# python media-understanding sidecar (D-184) — its own venv, deliberately
# separate from ai/.venv (mlx-vlm needs transformers>=5, ai/ pins <5)
ai-media/.venv/
ai-media/__pycache__/

# mcp server
mcp/target/
mcp/.venv/
mcp/__pycache__/
mcp/**/__pycache__/

# eval
eval/results/*.result.png

# scratch / media
scratch/*
!scratch/README.md
*.mp4
*.mov
*.exr
*.dpx
*.cube
!docs/**/*.cube
.DS_Store

# logs
*.log
logs/

# recoverable pre-monorepo fork history — archive it, then delete
engine-history.bundle
