{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // `vite/client` types `import.meta.hot`, used by `@apelles/store`'s shared
    // store factory (the same entry `packages/editor` and `packages/motion` list).
    "types": ["vite/client"]
  },
  "include": ["src"]
}
