{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // D-409 — `customOps.e2e.test.ts` runs the real component check, whose
    // module (`motion-engine/src/custom/sourceCheck.ts`) imports with `.ts`
    // (it also runs under plain Node type stripping).
    "allowImportingTsExtensions": true,
    // D-407 — the built-in templates ship as JSON data (`src/templates/*.json`).
    "resolveJsonModule": true,
    // B-233 — `theme.test.ts` reads fixtures via `node:fs`/`node:url`/`node:path`
    // (needs `node`). `vite/client` types `import.meta.hot`, used by
    // `@apelles/store` (pulled in through `motionProjectStore.ts`), same entry
    // `packages/editor` and `packages/store` list.
    "types": ["node", "vite/client"]
  },
  "include": ["src"]
}
