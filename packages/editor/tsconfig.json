{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // D-218 — `previewTiming.ts`'s call sites in `PreviewPane.tsx` are gated
    // on `import.meta.env.DEV`, which is Vite's own build-time constant; its
    // type comes from `vite/client` (the same entry `app/tsconfig.json`
    // already lists), not from anything hand-declared.
    "types": ["vite/client"]
  },
  "include": ["src"]
}
