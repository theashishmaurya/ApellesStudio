# Astro's generated type/content cache — regenerated by any astro command.
.astro/

# `wrangler pages dev dist` (serving a built site through the real Pages
# runtime locally, which is how a deploy gets checked before it goes near
# production) drops a miniflare cache/SQLite state tree here. Purely local.
.wrangler/

# Build output and deps are already covered by the repo-root .gitignore
# (dist/, node_modules/); repeated here so this directory is self-contained
# if it is ever used on its own.
dist/
node_modules/
.DS_Store
