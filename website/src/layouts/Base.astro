---
/**
 * Base.astro — the site's single document shell (D-264).
 *
 * What it is: <head>, fonts, global CSS, nav and footer around a slot.
 * What it does NOT do: any per-page logic — pages compose their own sections.
 *
 * Three families load, each with one job (src/data/palette.ts says why each was
 * chosen): Newsreader carries display and prose, Instrument Sans carries the
 * interface, IBM Plex Mono carries technical material. Newsreader is requested
 * with its optical-size axis so the display cut and the reading cut are the
 * same family behaving correctly at both ends, rather than two fonts.
 */
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { PIGMENTS } from '../data/palette.ts';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const origin = Astro.site ?? new URL('https://apelles.video');
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL('/shots/edit-transform.png', origin).href;

/** `theme-color` needs a literal, not a CSS variable — so it is read from the
 *  palette rather than typed a second time and left to drift. */
const themeColor = PIGMENTS.find((p) => p.token === 'pigment-marble')?.hex;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=Instrument+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      /* Hidden without leaving the document — a negative `left` offset would
         extend the scrollable overflow area and shift a full-page capture. */
      .skip {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 100;
        background: var(--pigment-basalt);
        color: var(--pigment-marble);
        font-family: var(--font-ui);
        padding: 0.6rem 1rem;
        font-size: var(--step--1);
        transform: translateY(-120%);
        transition: transform var(--dur-fast) var(--ease-out);
      }
      .skip:focus {
        transform: translateY(0);
      }
    </style>
  </body>
</html>
