---
/**
 * Base.astro — the site's single document shell (D-264, SEO pass D-288).
 *
 * What it is: <head>, fonts, global CSS, nav and footer around a slot.
 * What it does NOT do: any per-page logic — pages compose their own sections.
 *
 * Three families load, each with one job (src/data/palette.ts says why each was
 * chosen): Newsreader carries display and prose, Instrument Sans carries the
 * interface, IBM Plex Mono carries technical material. Newsreader is requested
 * with its optical-size axis so the display cut and the reading cut are the
 * same family behaving correctly at both ends, rather than two fonts.
 *
 * D-288: the social-preview image moved off an editor screenshot (D-288 also
 * hid those from every page — see index.astro/product.ts) onto the hero's
 * own commissioned painting, which is real, on-brand, and not mid-retake.
 * The `Astro.site` fallback also moved from a placeholder domain
 * (apelles.video) to the one D-265 actually records the owner buying
 * (apelles.studio) — that fallback only matters if this ever builds without
 * `site` set in astro.config.mjs, which itself now carries the real domain.
 * A minimal, honest `SoftwareApplication` JSON-LD block was added below —
 * only facts already asserted elsewhere on the site (name, description,
 * platform, price, licence), nothing invented for the sake of rich results.
 */
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { PIGMENTS } from '../data/palette.ts';
import { STATUS } from '../data/product.ts';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const origin = Astro.site ?? new URL('https://apelles.studio');
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL('/hero/painter.jpg', origin).href;

/** `theme-color` needs a literal, not a CSS variable — so it is read from the
 *  palette rather than typed a second time and left to drift. */
const themeColor = PIGMENTS.find((p) => p.token === 'pigment-marble')?.hex;

/**
 * Every claim here is already made, and tested, elsewhere on the site
 * (src/data/product.ts's STATUS, and the AGPL-3.0 licence D-002/D-003
 * settled on for the vendored engine) — this block restates them for search
 * engines, it does not introduce new ones.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Apelles',
  description:
    'A local, AI-native video editor. An agent handles the cutting, the colour and the motion graphics — through the same real controls, on your own machine.',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: STATUS.platform,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  license: 'https://www.gnu.org/licenses/agpl-3.0.html',
  url: origin.toString(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Apelles" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1568" />
    <meta property="og:image:height" content="1003" />
    <meta property="og:image:alt" content="Apelles, brush in hand, painting a filmstrip into the Greek landscape." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Loaded non-blocking (preload + swap-the-media-type-on-load), not as a
         synchronous <link rel="stylesheet">: a real Lighthouse trace against
         production found this exact request render-blocking, holding up first
         paint of the H1 (LCP) for ~800ms of its ~970ms total — the page's
         text doesn't need the web font loaded before it can paint (the
         fallback stack in tokens.css renders it immediately; the font swaps
         in once it arrives). <noscript> keeps the fallback for JS-disabled
         clients. -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=Instrument+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=Instrument+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=Instrument+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      />
    </noscript>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      /* Hidden without leaving the document — a negative `left` offset would
         extend the scrollable overflow area and shift a full-page capture. */
      .skip {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 100;
        background: var(--pigment-basalt);
        color: var(--pigment-marble);
        font-family: var(--font-ui);
        padding: 0.6rem 1rem;
        font-size: var(--step--1);
        transform: translateY(-120%);
        transition: transform var(--dur-fast) var(--ease-out);
      }
      .skip:focus {
        transform: translateY(0);
      }
    </style>
  </body>
</html>
