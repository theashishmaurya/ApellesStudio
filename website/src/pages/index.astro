---
/**
 * index.astro — the home page (D-264).
 *
 * The section order is an argument, and it is deliberately short: the promise
 * (hero) → the proof that a real application exists behind it (demo) → who it
 * is for and who it is not (difference) → what is in it (rooms) → why it is
 * built this way (machine) → the one ask (beta).
 *
 * Five bands and one action. Anything else a visitor might want has its own
 * page, so this one keeps a single focal point.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Demo from '../components/Demo.astro';
import Difference from '../components/Difference.astro';
import Rooms from '../components/Rooms.astro';
import Machine from '../components/Machine.astro';
import Beta from '../components/Beta.astro';
---

<Base
  title="Apelles — the video app for people who never learned to edit"
  description="You already know what your video should look like. Apelles is the part you were missing: describe what you want, and a real AI agent does the cutting, the colour and the motion graphics — free, open source, and running on your own machine."
>
  <Hero />
  <Demo />
  <Difference />
  <Rooms />
  <Machine />
  <Beta />
</Base>
