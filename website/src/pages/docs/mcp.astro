    font-weight: 400;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border-color);
    margin-bottom: 1.25rem;
  }

  .prose h3 {
    font-size: var(--step-0);
    font-weight: 500;
    margin: 2rem 0 0.75rem;
  }

  .prose p {
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .prose pre {
