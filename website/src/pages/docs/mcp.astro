    padding: 1rem 1.1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border-color);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-size: 0.78rem;
    line-height: 1.8;
    color: var(--color-text-primary);
  }

