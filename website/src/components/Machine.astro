---
/**
 * Machine.astro — how it is built, and why that is your problem too (D-264,
 * the tool-count line cut by D-288).
 *
 * What it is: the four structural commitments, each written as what it means
 * for the person using the app rather than as an architecture note, with the
 * checkable fact printed underneath it.
 * What it does NOT do: put them in a 2×2 card grid. Four boxes of equal weight
 * is the shape that makes generated pages look generated; a flowing list under
 * one heading lets the eye read them in order and stop at the one it cares
 * about. It also no longer prints the shipped-MCP-tool total or the
 * "Connect an agent" link (D-288, the owner's own trim — `/docs/mcp/` is
 * hidden from routing for now, see src/pages/docs/_mcp.astro) — the tool
 * total still lives, verified against `mcp/server.py`, in `src/data/mcp.ts`.
 */
import { PILLARS } from '../data/product.ts';
---

<section class="machine section" id="machine">
  <div class="shell wrap">
    <div class="lead">
      <p class="eyebrow">How it is built</p>
      <h2>It runs on your machine, and it hands the agent the real controls.</h2>
      <p class="lede">
        Four commitments, each of them checkable in the source rather than a promise on a marketing
        page.
      </p>
    </div>

    <dl class="pillars">
      {
        PILLARS.map((p) => (
          <div class="pillar">
            <dt>{p.title}</dt>
            <dd>
              <p>{p.body}</p>
              <p class="proof">{p.proof}</p>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  /* A basalt section (D-282): see tokens.css's --ink-inverse comment — same two
     neutrals mirrored, ochre standing in for terracotta as the working colour. */
  .machine {
    background: var(--pigment-basalt);
    border-block: 1px solid var(--edge-inverse);
  }

  .wrap {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 1rem + 5vw, 5.5rem);
    align-items: start;
  }

  .eyebrow {
    color: var(--ink-inverse-soft);
  }

  h2 {
    font-size: var(--step-3);
    margin-top: 1rem;
    max-width: 18ch;
    font-weight: 300;
    color: var(--ink-inverse);
  }

  .lead .lede {
    margin-top: 1.25rem;
    font-size: var(--step-0);
    max-width: 40ch;
    color: var(--ink-inverse-soft);
  }

  .more {
    margin-top: 1.75rem;
  }

  .onward {
    color: var(--pigment-ochre);
  }

  .pillars {
    margin: 0;
  }

  .pillar {
    padding-block: 1.4rem;
    border-top: 1px solid var(--edge-inverse);
  }
  .pillar:last-child {
    border-bottom: 1px solid var(--edge-inverse);
  }

  dt {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.25;
    color: var(--ink-inverse);
  }

  dd {
    margin: 0.55rem 0 0;
    max-width: 58ch;
  }

  dd p {
    color: var(--ink-inverse-soft);
  }

  /* The checkable fact. Interface face, one size down — it is a citation, not
     a second paragraph of prose. */
  .proof {
    margin-top: 0.7rem;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-inverse-soft);
    padding-left: 0.9rem;
    border-left: 1px solid var(--edge-inverse-strong);
  }

  @media (max-width: 880px) {
    .wrap {
      grid-template-columns: minmax(0, 1fr);
    }
    h2 {
      max-width: 22ch;
    }
  }
</style>
