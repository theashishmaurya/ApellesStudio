---
/**
 * Signature.astro — the site's one primary-action element on a page (D-264;
 * ink instead of rose since D-284).
 *
 * What it is: the site's single primary action, rendered as either the link
 * that carries you to the signup or the signup's own submit button. A solid
 * basalt-ink fill (`.signature` in global.css) — see palette.ts's own header
 * comment for why this moved off a scarce colour and onto ink instead.
 * What it does NOT do: appear twice on a page, or get used for a secondary
 * action. `tests/build-output.test.ts` asserts at most one `.signature` per
 * built page, so the one-primary-action discipline is enforced rather than
 * remembered — that discipline outlived the rose pigment that used to carry
 * it.
 */
interface Props {
  /** Where it goes. Omit to render a form submit button instead. */
  href?: string;
  /** The label. Written as the visitor's own next move, not as a command. */
  label: string;
  /** Only for the submit form of the button. */
  id?: string;
}

const { href, label, id } = Astro.props;
---

{
  href ? (
    <a class="signature" href={href}>
      {label}
      <span class="arrow" aria-hidden="true">
        &rarr;
      </span>
    </a>
  ) : (
    <button class="signature" type="submit" id={id} data-submit>
      <span data-label>{label}</span>
    </button>
  )
}

<style>
  .arrow {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .signature:hover .arrow {
    transform: translateX(4px);
  }
</style>
