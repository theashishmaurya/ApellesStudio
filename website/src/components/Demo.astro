---
/**
 * Demo.astro — the product demonstration (D-264, carrying D-255's interaction
 * forward).
 *
 * What it is: real screenshots of the running application, hung on the page as
 * a framed dark object and genuinely scrubbable. The playhead really moves, the
 * timecode really counts frames, the preview really cuts between captures at
 * real edit points, and the two numeric fields implement the app's own
 * drag-to-scrub gesture (D-253: 8px per declared step, Shift ×10, Cmd/Ctrl ÷10,
 * 4px drag threshold) against the live preview.
 *
 * What it does NOT do: play video. No recorded demo of Apelles exists yet — see
 * website/TODO-DEMO-VIDEO.md — and a marketing site for a video tool must not
 * fake one. The caption says so in plain language and a test asserts it stays.
 *
 * Why a scrub rather than a scroll effect: the physical sensation of using this
 * app is dragging — a playhead across a timeline, a number to change a value.
 * That is the motion worth reproducing, and it is the only motion on the page.
 */

/** The real screenshots, in cut order, with the frame each cuts in on.
 *  30 fps, so `at` reads directly as a timecode.
 *
 *  Every image here was opened and confirmed to be what its caption says
 *  before it was used. All three are 2692×1800, so the stage never reflows. */
const FRAMES = [
  {
    at: 0,
    src: '/shots/edit-timeline.webp',
    label: 'before-1.09.51pm.mov',
    alt: 'Apelles mid-edit: a vertical 1080×1920 preview, the Split / Marker / Transitions toolbar, and a video track showing a real filmstrip of the clip’s own frames with a marker pinned above it.',
  },
  {
    at: 700,
    src: '/shots/edit-composite.webp',
    label: 'after-1.08.16pm.mov',
    alt: '',
  },
  {
    at: 1400,
    src: '/shots/edit-inspector.webp',
    label: 'before-1.09.51pm.mov',
    alt: '',
  },
];

const TOTAL = 2100;

/** Two markers, on the two cuts. Ochre and terracotta — marks, not text, so the
 *  working pair is doing exactly the job it is allowed to do. */
const MARKS = [
  { at: 700, tone: 'var(--pigment-ochre)' },
  { at: 1400, tone: 'var(--pigment-terracotta)' },
];
---

<section class="demo section" id="demo">
  <div class="shell head">
    <p class="eyebrow">What you are actually getting</p>
    <h2>A real editor. You just do not have to work it.</h2>
    <p class="lede">
      Everything below is the running application, captured on a real project. Drag the playhead.
      Drag the numbers. That gesture is the app&rsquo;s own, and it is there for the moments you
      want to nudge something yourself rather than ask for it.
    </p>
  </div>

  <div class="shell">
    <figure class="stage frame" data-stage>
      <!-- No fake window chrome above the image: the screenshots already contain
           the real application's own title bar, and drawing a second one around
           them would be both redundant and a lie about what you are looking at.
           The only chrome this figure adds is the transport strip below, which
           is genuinely ours and genuinely works. -->
      <div class="canvas" data-canvas>
        {
          FRAMES.map((f, i) => (
            <img
              src={f.src}
              alt={f.alt}
              aria-hidden={i === 0 ? 'false' : 'true'}
              width="2692"
              height="1800"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              data-frame={f.at}
              class:list={['shot', { on: i === 0 }]}
            />
          ))
        }
      </div>

      <div class="strip transport">
        <span class="clip mono" data-clip>{FRAMES[0].label}</span>
        <span class="tc mono" data-tc>00:00:00:00</span>

        <div
          class="track"
          data-track
          role="slider"
          tabindex="0"
          aria-label="Scrub the preview"
          aria-valuemin="0"
          aria-valuemax={TOTAL}
          aria-valuenow="0"
          aria-valuetext="00:00:00:00"
        >
          <span class="fill" data-fill></span>
          {
            MARKS.map((m) => (
              <span class="mark" style={`left:${(m.at / TOTAL) * 100}%;--tone:${m.tone}`} />
            ))
          }
          <span class="playhead" data-head></span>
        </div>

        <div class="fields">
          <label class="field">
            <span>Scale</span>
            <input
              type="number"
              data-num="scale"
              value="1"
              min="0.4"
              max="1"
              step="0.01"
              aria-label="Scale — drag horizontally to change"
            />
          </label>
          <label class="field">
            <span>Opacity</span>
            <input
              type="number"
              data-num="opacity"
              value="1"
              min="0.2"
              max="1"
              step="0.01"
              aria-label="Opacity — drag horizontally to change"
            />
          </label>
        </div>
      </div>
    </figure>

    <figcaption class="cap">
      Real screenshots of the running application, scrubbable. Apelles has no recorded product demo
      yet, and there is no stand-in for one on this page. These captures predate the rename, so the
      app&rsquo;s own title bar still reads <span class="mono">CHROMA</span> &mdash; they will be
      retaken rather than retouched.
    </figcaption>
  </div>
</section>

<style>
  .head {
    margin-bottom: clamp(2rem, 1.25rem + 3vw, 3.5rem);
  }

  h2 {
    font-size: var(--step-4);
    margin: 1rem 0 1.5rem;
    max-width: 20ch;
    font-weight: 300;
  }

  /* ---- the framed object --------------------------------------------- */

  .stage {
    margin: 0;
  }

  .strip {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0 0.95rem;
    min-height: 42px;
    background: var(--app-surface);
    color: var(--app-text-secondary);
  }

  .clip {
    font-size: var(--step--2);
    max-width: 24ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .canvas {
    position: relative;
    aspect-ratio: 2692 / 1800;
    background: var(--app-bg-primary);
    overflow: hidden;
  }

  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    /* Set by script; declared here so the first paint is correct. */
    transform: scale(var(--z, 1));
    transform-origin: center;
    transition: opacity 220ms var(--ease-out);
    will-change: opacity;
  }
  .shot.on {
    opacity: var(--a, 1);
  }

  .transport {
    border-top: 1px solid var(--app-border-color);
    padding-block: 0.5rem;
    flex-wrap: wrap;
  }

  .tc {
    font-size: var(--step--2);
    color: var(--app-text-primary);
  }

  .track {
    position: relative;
    flex: 1 1 180px;
    height: 22px;
    cursor: ew-resize;
    touch-action: none;
    display: flex;
    align-items: center;
  }
  .track::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--app-border-color);
    border-radius: 2px;
  }

  .fill {
    position: absolute;
    left: 0;
    height: 3px;
    width: 0;
    background: var(--app-text-secondary);
    border-radius: 2px;
  }

  /* The app's flag shape: a small square pinned to a frame. */
  .mark {
    position: absolute;
    top: 1px;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    background: var(--tone);
    border-radius: 1px;
  }

  .playhead {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    margin-left: -1px;
    background: var(--app-accent);
  }
  .playhead::after {
    content: '';
    position: absolute;
    top: -1px;
    left: -4px;
    width: 10px;
    height: 8px;
    background: var(--app-accent);
    border-radius: 1px;
  }

  .fields {
    display: flex;
    gap: 0.9rem;
  }

  .field {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-ui);
    font-size: var(--step--2);
    color: var(--app-text-secondary);
  }

  /* D-253: the native spinner is suppressed and the field itself is dragged. */
  .field input {
    inline-size: 62px;
    background: var(--app-bg-primary);
    border: 1px solid var(--app-border-color);
    border-radius: 6px;
    color: var(--app-text-primary);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--step--2);
    padding: 0.25rem 0.45rem;
    text-align: right;
    cursor: ew-resize;
    touch-action: none;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .field input::-webkit-outer-spin-button,
  .field input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }
  .field input[type='number'] {
    -moz-appearance: textfield;
    appearance: textfield;
  }
  .field input:hover,
  .field input:focus {
    border-color: var(--app-text-secondary);
  }
  .field input[data-dragging] {
    border-color: var(--app-accent);
  }

  .cap {
    margin-top: 1rem;
    font-family: var(--font-ui);
    font-size: var(--step--2);
    line-height: 1.7;
    color: var(--pigment-basalt-soft);
    max-width: 62ch;
  }

  @media (max-width: 760px) {
    .fields {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>

<script>
  /**
   * The demonstration's behaviour. Two interactions, both real:
   *   1. the playhead scrubs the filmstrip and drives the timecode readout;
   *   2. the numeric fields use the app's own drag-to-scrub gesture (D-253).
   * Pointer-, keyboard- and touch-driven, and a safe no-op if the markup is
   * absent.
   */
  const FPS = 30;
  const TOTAL_FRAMES = 2100;

  /** Frames -> HH:MM:SS:FF, the app's own non-drop timecode form. */
  function timecode(frame: number): string {
    const f = Math.max(0, Math.round(frame));
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${pad(Math.floor(f / (FPS * 3600)))}:${pad(Math.floor(f / (FPS * 60)) % 60)}:${pad(
      Math.floor(f / FPS) % 60,
    )}:${pad(f % FPS)}`;
  }

  const stage = document.querySelector<HTMLElement>('[data-stage]');
  if (stage) {
    const track = stage.querySelector<HTMLElement>('[data-track]');
    const head = stage.querySelector<HTMLElement>('[data-head]');
    const fill = stage.querySelector<HTMLElement>('[data-fill]');
    const tc = stage.querySelector<HTMLElement>('[data-tc]');
    const clip = stage.querySelector<HTMLElement>('[data-clip]');
    const shots = Array.from(stage.querySelectorAll<HTMLImageElement>('.shot'));
    const cuts = shots.map((s) => Number(s.dataset.frame ?? 0));
    const labels = ['before-1.09.51pm.mov', 'after-1.08.16pm.mov', 'before-1.09.51pm.mov'];

    let frame = 0;

    const render = () => {
      const pct = (frame / TOTAL_FRAMES) * 100;
      if (head) head.style.left = `${pct}%`;
      if (fill) fill.style.width = `${pct}%`;
      const t = timecode(frame);
      if (tc) tc.textContent = t;
      if (track) {
        track.setAttribute('aria-valuenow', String(Math.round(frame)));
        track.setAttribute('aria-valuetext', t);
      }

      // Which clip is under the playhead: the last cut at or before it.
      let idx = 0;
      for (let i = 0; i < cuts.length; i++) if (frame >= cuts[i]) idx = i;
      shots.forEach((s, i) => s.classList.toggle('on', i === idx));
      if (clip) clip.textContent = labels[idx] ?? '';
    };

    const seekTo = (clientX: number) => {
      if (!track) return;
      const r = track.getBoundingClientRect();
      const ratio = r.width > 0 ? (clientX - r.left) / r.width : 0;
      frame = Math.min(TOTAL_FRAMES, Math.max(0, ratio * TOTAL_FRAMES));
      render();
    };

    if (track) {
      let scrubbing = false;
      track.addEventListener('pointerdown', (e: PointerEvent) => {
        scrubbing = true;
        track.setPointerCapture(e.pointerId);
        seekTo(e.clientX);
      });
      track.addEventListener('pointermove', (e: PointerEvent) => {
        if (scrubbing) seekTo(e.clientX);
      });
      const stop = (e: PointerEvent) => {
        scrubbing = false;
        if (track.hasPointerCapture(e.pointerId)) track.releasePointerCapture(e.pointerId);
      };
      track.addEventListener('pointerup', stop);
      track.addEventListener('pointercancel', stop);

      // Keyboard: a frame at a time, a second with Shift, ends with Home/End.
      track.addEventListener('keydown', (e: KeyboardEvent) => {
        const step = e.shiftKey ? FPS : 1;
        let next = frame;
        if (e.key === 'ArrowRight') next = frame + step;
        else if (e.key === 'ArrowLeft') next = frame - step;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = TOTAL_FRAMES;
        else return;
        e.preventDefault();
        frame = Math.min(TOTAL_FRAMES, Math.max(0, next));
        render();
      });
    }

    render();

    /**
     * D-253's virtual slider, reproduced: 8px of horizontal travel per declared
     * `step`, Shift multiplies the step by 10, Cmd/Ctrl divides it by 10, and a
     * 4px threshold separates a click (which focuses, to type a value) from a
     * drag. Applied here to the preview's own scale and opacity.
     */
    const PX_PER_STEP = 8;
    const THRESHOLD = 4;
    const canvas = stage.querySelector<HTMLElement>('[data-canvas]');

    const applyToCanvas = () => {
      if (!canvas) return;
      const get = (k: string) =>
        Number(stage.querySelector<HTMLInputElement>(`[data-num="${k}"]`)?.value ?? 1);
      canvas.style.setProperty('--z', String(get('scale')));
      canvas.style.setProperty('--a', String(get('opacity')));
    };

    const decimalsOf = (step: number) => {
      const s = String(step);
      const dot = s.indexOf('.');
      return dot === -1 ? 0 : s.length - dot - 1;
    };

    stage.querySelectorAll<HTMLInputElement>('[data-num]').forEach((input) => {
      const step = Number(input.step) || 1;
      const min = Number(input.min);
      const max = Number(input.max);
      const dp = decimalsOf(step);
      let startX = 0;
      let startVal = 0;
      let active = false;
      let passed = false;

      input.addEventListener('pointerdown', (e: PointerEvent) => {
        active = true;
        passed = false;
        startX = e.clientX;
        startVal = Number(input.value) || 0;
        input.setPointerCapture(e.pointerId);
      });

      input.addEventListener('pointermove', (e: PointerEvent) => {
        if (!active) return;
        const dx = e.clientX - startX;
        if (!passed) {
          if (Math.abs(dx) < THRESHOLD) return;
          passed = true;
          input.dataset.dragging = 'true';
        }
        e.preventDefault();
        const mult = e.shiftKey ? 10 : e.metaKey || e.ctrlKey ? 0.1 : 1;
        const next = startVal + (dx / PX_PER_STEP) * step * mult;
        input.value = Math.min(max, Math.max(min, next)).toFixed(dp);
        applyToCanvas();
      });

      const end = (e: PointerEvent) => {
        if (!active) return;
        active = false;
        delete input.dataset.dragging;
        if (input.hasPointerCapture(e.pointerId)) input.releasePointerCapture(e.pointerId);
      };
      input.addEventListener('pointerup', end);
      input.addEventListener('pointercancel', end);
      input.addEventListener('input', applyToCanvas);
    });

    applyToCanvas();
  }
</script>
