---
/**
 * Nav.astro — the top bar (D-255).
 *
 * Deliberately modelled on the app's own chrome bar: the CHROMA wordmark hard
 * left in wide-tracked caps, the section links centred the way the app centres
 * Edit / Motion / Colorist, and one action hard right where the app puts Export.
 * It is not a generic sticky SaaS header with a pill CTA.
 */
const links = [
  { href: '/#tabs', label: 'Product' },
  { href: '/#mcp', label: 'MCP' },
  { href: '/docs/mcp/', label: 'Docs' },
  { href: '/#local', label: 'Local-first' },
];
---

<header class="bar">
  <div class="inner">
    <a class="mark" href="/">Chroma</a>
    <nav class="mid" aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="cta" href="/#beta">Request beta access</a>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg-primary) 88%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border-color);
  }

  .inner {
    max-width: var(--shell-max);
    margin-inline: auto;
    padding: 0 var(--gutter);
    height: 56px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  /* The app's own wordmark treatment: uppercase, tracked out, quiet weight. */
  .mark {
    font-size: var(--step--1);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 500;
    justify-self: start;
  }

  .mid {
    display: flex;
    gap: 1.75rem;
    justify-self: center;
  }

  .mid a {
    font-size: var(--step--1);
    color: var(--color-text-secondary);
    position: relative;
    padding-block: 4px;
    transition: color var(--dur-fast) var(--ease-out);
  }

  /* The app's tab language: a 2px accent bar under the label (Shell.tsx,
     TimelineSwitcher.tsx), grown from the centre rather than snapped on. */
  .mid a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .mid a:hover {
    color: var(--color-text-primary);
  }

  .mid a:hover::after {
    transform: scaleX(1);
  }

  .cta {
    justify-self: end;
    font-size: var(--step--1);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-color);
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur-slow) var(--ease-out),
      background-color var(--dur-slow) var(--ease-out);
  }

  .cta:hover {
    border-color: var(--color-accent);
    background: var(--color-card-active);
  }

  @media (max-width: 800px) {
    .mid {
      display: none;
    }
    .inner {
      grid-template-columns: 1fr auto;
    }
  }
</style>
