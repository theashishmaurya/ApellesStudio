---
/**
 * LocalFirst.astro — the positioning section (D-255).
 *
 * Composition: one very large statement standing alone, then the four pillars
 * as a staggered list with the proof set apart from the claim. Not a card grid;
 * the point of the section is that each claim is checkable, so each one shows
 * its receipt.
 */
import { PILLARS, STATUS } from '../data/product.ts';
---

<section class="lf section" id="local">
  <div class="shell">
    <p class="eyebrow">Why it is built this way</p>

    <p class="statement">
      There is no server.<br />
      <span class="quiet">Not a private one. Not a fast one. Not one at all.</span>
    </p>

    <div class="grid">
      {
        PILLARS.map((p, i) => (
          <article class="pil">
            <span class="idx mono">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{p.title}</h3>
              <p class="body">{p.body}</p>
              <p class="proof">{p.proof}</p>
            </div>
          </article>
        ))
      }
    </div>

    <dl class="facts">
      <div><dt>Stage</dt><dd class="mono">{STATUS.stage}</dd></div>
      <div><dt>Platform</dt><dd class="mono">{STATUS.platform}</dd></div>
      <div><dt>Licence</dt><dd class="mono">{STATUS.licence}</dd></div>
      <div><dt>Windows</dt><dd class="mono dim">{STATUS.windows}</dd></div>
    </dl>
  </div>
</section>

<style>
  .statement {
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 200;
    line-height: 1.02;
    letter-spacing: -0.045em;
    margin: 1.5rem 0 clamp(3rem, 2rem + 5vw, 6rem);
  }

  .statement .quiet {
    color: var(--color-text-secondary);
    font-size: var(--step-3);
    font-weight: 200;
    letter-spacing: -0.02em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 1rem + 5vw, 6rem);
  }

  .pil {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--color-border-color);
  }

  /* Stagger: the right column drops half a beat, so the two columns do not
     read as four identical tiles. */
  .pil:nth-child(even) {
    margin-top: 2.5rem;
  }

  .idx {
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
    padding-top: 0.45em;
  }

  .pil h3 {
    font-size: var(--step-1);
    font-weight: 400;
    margin-bottom: 0.6rem;
  }

  .body {
    color: var(--color-text-secondary);
    font-size: var(--step--1);
    max-width: 46ch;
  }

  /* The receipt, visually separated from the claim it backs. */
  .proof {
    margin-top: 0.9rem;
    padding-left: 0.9rem;
    border-left: 1px solid var(--color-border-color);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 46ch;
  }

  .facts {
    margin: clamp(3rem, 2rem + 4vw, 5rem) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(2rem, 1rem + 5vw, 6rem);
    border-top: 1px solid var(--color-border-color);
    padding-top: 1.5rem;
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 0.35rem;
  }

  .facts dd {
    margin: 0;
    font-size: var(--step--1);
  }
  .facts .dim {
    color: var(--color-text-secondary);
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .pil:nth-child(even) {
      margin-top: 0;
    }
  }
</style>
