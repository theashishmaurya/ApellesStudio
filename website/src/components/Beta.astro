---
/**
 * Beta.astro — pre-launch signup (D-255's mechanism, D-264's presentation,
 * pointed at a real FormSubmit.co endpoint 2026-09-10).
 *
 * What it is: a real form with real client-side validation and real
 * submitting/success/error states, posting to FormSubmit.co's JSON/AJAX
 * endpoint, which emails each submission straight to the owner's inbox. The
 * fuller ask on the page, further explained, with the role dropdown the
 * compact hero form (Hero.astro) leaves out.
 * What it does NOT do: use <Signature/> any more (D-283) — the signature
 * treatment moved up to Hero.astro's own copy of this same form, which is
 * now the page's one primary action, and a page carries only one (D-264's
 * own rule, ink now rather than a scarce colour since D-284, but the
 * one-per-page discipline itself unchanged). This section's button is
 * deliberately plain instead, not a second primary action.
 * It also does not post anywhere until a real endpoint is set in
 * `src/data/beta.ts` — one is now set, but the guard stays, since a fresh
 * clone or a different owner starts from the placeholder again.
 *
 * The submit logic below is deliberately unchanged from D-255/D-264: it
 * worked, and rewriting working infrastructure to swap providers is churn.
 * Only the endpoint URL shape and the honeypot field name changed, because
 * FormSubmit's own conventions differ from Formspree's — see beta.ts.
 *
 * Setup: website/BETA_SIGNUP_SETUP.md.
 */
import { BETA_FORM_ENDPOINT, isPlaceholderEndpoint, ROLES } from '../data/beta.ts';

const endpoint = BETA_FORM_ENDPOINT;
const placeholder = isPlaceholderEndpoint(endpoint);
---

<section class="beta section" id="beta">
  <div class="shell wrap">
    <div class="copy">
      <p class="eyebrow">Pre-launch</p>
      <h2>Be there when it opens.</h2>
      <p class="lede">
        There is no public build yet. Leave an address and you will hear from us once there is one
        worth installing &mdash; that message, and nothing else.
      </p>
    </div>

    <form
      class="form"
      data-beta-form
      data-endpoint={endpoint}
      data-placeholder={placeholder ? 'true' : 'false'}
      action={endpoint}
      method="POST"
      novalidate
    >
      <div class="row">
        <label for="beta-email">Email</label>
        <input
          id="beta-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="you@example.com"
          required
          aria-describedby="beta-email-err"
        />
        <p class="err" id="beta-email-err" data-err hidden></p>
      </div>

      <div class="row">
        <label for="beta-role">What do you make? <span class="opt">optional</span></label>
        <select id="beta-role" name="role">
          <option value="">Prefer not to say</option>
          {ROLES.map((r) => <option value={r}>{r}</option>)}
        </select>
      </div>

      <!-- A plain email subject, so a real signup doesn't land as an unlabelled
           "New submission!" — FormSubmit's own _subject convention. -->
      <input type="hidden" name="_subject" value="New Apelles beta signup" />

      <!-- Honeypot: a real bot trap, visually and semantically hidden from people.
           `_honey` is FormSubmit's own honeypot field name — a submission with
           this filled in is silently discarded rather than emailed. -->
      <div class="hp" aria-hidden="true">
        <label for="beta-company">Company</label>
        <input id="beta-company" name="_honey" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button class="submit" type="submit" data-submit>
        <span data-label>Request beta access</span>
      </button>

      <p class="status" data-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 1rem + 5vw, 6rem);
    align-items: start;
  }

  h2 {
    font-size: var(--step-4);
    margin: 1rem 0 1.5rem;
    font-weight: 300;
  }

  /* A basalt card (D-282): the form is its own inverse-toned island on the
     marble page, same pairing as a full basalt section — see tokens.css's
     --ink-inverse comment. The inputs stay marble (below), so only the label/
     error/status text directly on the card needs the inverse ink. */
  .form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    border: 1px solid var(--edge-inverse-strong);
    border-radius: var(--radius-lg);
    background: var(--pigment-basalt);
    padding: clamp(1.25rem, 0.8rem + 1.6vw, 2rem);
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  label {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-inverse-soft);
  }

  .opt {
    font-size: var(--step--2);
    opacity: 0.75;
  }

  input[type='email'],
  select {
    width: 100%;
    background: var(--pigment-marble);
    border: 1px solid var(--edge-strong);
    border-radius: var(--radius-md);
    color: var(--pigment-basalt);
    font-family: var(--font-ui);
    font-size: var(--step-0);
    padding: 0.7rem 0.8rem;
    transition: border-color var(--dur-slow) var(--ease-out);
  }

  input[type='email']:hover,
  select:hover {
    border-color: var(--pigment-basalt-soft);
  }
  input[type='email']:focus,
  select:focus {
    border-color: var(--pigment-basalt);
  }
  input[aria-invalid='true'] {
    border-color: var(--pigment-terracotta);
  }

  .err {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--step--2);
    color: var(--danger-inverse);
  }

  /* Deliberately not rose (see this file's own header comment): a marble
     pill on the dark card, the same non-signature treatment Hero.astro's own
     input already carries, so the two forms still read as one family. */
  .submit {
    background: var(--pigment-marble);
    color: var(--pigment-basalt);
    font-family: var(--font-ui);
    font-size: var(--step-0);
    font-weight: 500;
    border: 0;
    border-radius: var(--radius-md);
    padding: 0.85rem 1.4rem;
    cursor: pointer;
    transition:
      filter var(--dur-slow) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .submit:hover:not(:disabled) {
    filter: brightness(0.96);
  }
  .submit:active:not(:disabled) {
    transform: translateY(1px);
  }
  .submit:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .status {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--step--2);
    line-height: 1.6;
    color: var(--ink-inverse-soft);
    min-height: 1.2em;
  }
  .status[data-tone='ok'] {
    color: var(--ink-inverse);
  }
  .status[data-tone='bad'] {
    color: var(--danger-inverse);
  }

  @media (max-width: 880px) {
    .wrap {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  /**
   * Real submit handling, shared by every `[data-beta-form]` on the page —
   * this is Hero.astro's compact inline form as well as this section's own
   * full one (D-283). One handler, found generically per form rather than by
   * a hardcoded input id, so a second instance needs no script of its own:
   * `document.querySelectorAll` runs against the whole rendered page, not
   * just this component's own markup, and the email input is found by its
   * `name` rather than an id two instances could never both hold at once.
   * Validates, disables while in flight, reports the outcome, and refuses to
   * post at all while the endpoint is the placeholder shipped in
   * src/data/beta.ts.
   */
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  document.querySelectorAll<HTMLFormElement>('[data-beta-form]').forEach((form) => {
    const email = form.querySelector<HTMLInputElement>('[name="email"]');
    const err = form.querySelector<HTMLElement>('[data-err]');
    const status = form.querySelector<HTMLElement>('[data-status]');
    const button = form.querySelector<HTMLButtonElement>('[data-submit]');
    const label = form.querySelector<HTMLElement>('[data-label]');
    if (!email || !err || !status || !button || !label) return;

    const setErr = (msg: string) => {
      err.textContent = msg;
      err.hidden = msg === '';
      email.setAttribute('aria-invalid', msg === '' ? 'false' : 'true');
    };

    const setStatus = (msg: string, tone: 'ok' | 'bad' | '' = '') => {
      status.textContent = msg;
      if (tone) status.dataset.tone = tone;
      else delete status.dataset.tone;
    };

    email.addEventListener('input', () => {
      if (err.hidden === false) setErr('');
    });

    form.addEventListener('submit', async (e: SubmitEvent) => {
      e.preventDefault();
      setStatus('');

      const value = email.value.trim();
      if (value === '') {
        setErr('An email address is required.');
        email.focus();
        return;
      }
      if (!EMAIL.test(value)) {
        setErr('That does not look like an email address.');
        email.focus();
        return;
      }
      setErr('');

      if (form.dataset.placeholder === 'true') {
        setStatus(
          'Signup is not wired up yet — this site is still pre-launch. Nothing was sent, so please try again once the form is live.',
          'bad',
        );
        return;
      }

      button.disabled = true;
      label.textContent = 'Sending…';

      try {
        const res = await fetch(form.dataset.endpoint ?? form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });

        if (res.ok) {
          form.reset();
          setStatus('You are on the list. We will be in touch when there is a build.', 'ok');
          label.textContent = 'Request beta access';
          button.disabled = false;
          return;
        }
        setStatus('That did not go through. Please try again in a moment.', 'bad');
      } catch {
        setStatus('Could not reach the server. Check your connection and try again.', 'bad');
      }

      label.textContent = 'Request beta access';
      button.disabled = false;
    });
  });
</script>
