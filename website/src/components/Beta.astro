---
/**
 * Beta.astro — pre-launch signup (D-255's mechanism, D-264's presentation,
 * pointed at the site's own waitlist by D-426).
 *
 * What it is: a real form with real client-side validation and real
 * submitting/success/error states, posting JSON to `/api/waitlist`
 * (functions/_lib/waitlist.ts), which stores the address and emails a
 * confirmation link. The fuller ask on the page, with the role dropdown the
 * compact hero form (Hero.astro) leaves out. The submit script below is shared
 * by both forms.
 * What it does NOT do: use <Signature/> (D-283) — the page's one primary
 * action is the hero's; this section's button is deliberately plain. It does
 * not say "you are on the list" before the address is confirmed.
 *
 * Setup: website/BETA_SIGNUP_SETUP.md.
 */
import { BETA_FORM_ENDPOINT, ROLES } from '../data/beta.ts';
import TurnstileWidget from './TurnstileWidget.astro';
---

<section class="beta section" id="beta">
  <div class="shell wrap">
    <div class="copy">
      <p class="eyebrow">Beta</p>
      <h2>The beta is out. Try it.</h2>
      <p class="lede">
        A free build for Apple Silicon Macs &mdash; <a class="install" href="/install/">here is how
        to install it</a>. Leave an address to hear when a new build lands &mdash; that message, and
        nothing else.
      </p>
    </div>

    <form
      class="form"
      data-beta-form
      action={BETA_FORM_ENDPOINT}
      method="POST"
      novalidate
    >
      <div class="row">
        <label for="beta-email">Email</label>
        <input
          id="beta-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="you@example.com"
          required
          aria-describedby="beta-email-err"
        />
        <p class="err" id="beta-email-err" data-err hidden></p>
      </div>

      <div class="row">
        <label for="beta-role">What do you make? <span class="opt">optional</span></label>
        <select id="beta-role" name="role">
          <option value="">Prefer not to say</option>
          {ROLES.map((r) => <option value={r}>{r}</option>)}
        </select>
      </div>

      <input type="hidden" name="source" value="beta" />

      <TurnstileWidget />

      <!-- Honeypot: a real bot trap, visually and semantically hidden from people.
           A submission with this filled in is dropped by the server. -->
      <div class="hp" aria-hidden="true">
        <label for="beta-company">Company</label>
        <input id="beta-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button class="submit" type="submit" data-submit>
        <span data-label>Request beta access</span>
      </button>

      <p class="status" data-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .install {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 1rem + 5vw, 6rem);
    align-items: start;
  }

  h2 {
    font-size: var(--step-4);
    margin: 1rem 0 1.5rem;
    font-weight: 300;
  }

  /* A basalt card (D-282): the form is its own inverse-toned island on the
     marble page, same pairing as a full basalt section — see tokens.css's
     --ink-inverse comment. The inputs stay marble (below), so only the label/
     error/status text directly on the card needs the inverse ink. */
  .form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    border: 1px solid var(--edge-inverse-strong);
    border-radius: var(--radius-lg);
    background: var(--pigment-basalt);
    padding: clamp(1.25rem, 0.8rem + 1.6vw, 2rem);
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  label {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-inverse-soft);
  }

  .opt {
    font-size: var(--step--2);
    opacity: 0.75;
  }

  input[type='email'],
  select {
    width: 100%;
    background: var(--pigment-marble);
    border: 1px solid var(--edge-strong);
    border-radius: var(--radius-md);
    color: var(--pigment-basalt);
    font-family: var(--font-ui);
    font-size: var(--step-0);
    padding: 0.7rem 0.8rem;
    transition: border-color var(--dur-slow) var(--ease-out);
  }

  input[type='email']:hover,
  select:hover {
    border-color: var(--pigment-basalt-soft);
  }
  input[type='email']:focus,
  select:focus {
    border-color: var(--pigment-basalt);
  }
  input[aria-invalid='true'] {
    border-color: var(--pigment-terracotta);
  }

  .err {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--step--2);
    color: var(--danger-inverse);
  }

  /* Deliberately not rose (see this file's own header comment): a marble
     pill on the dark card, the same non-signature treatment Hero.astro's own
     input already carries, so the two forms still read as one family. */
  .submit {
    background: var(--pigment-marble);
    color: var(--pigment-basalt);
    font-family: var(--font-ui);
    font-size: var(--step-0);
    font-weight: 500;
    border: 0;
    border-radius: var(--radius-md);
    padding: 0.85rem 1.4rem;
    cursor: pointer;
    transition:
      filter var(--dur-slow) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .submit:hover:not(:disabled) {
    filter: brightness(0.96);
  }
  .submit:active:not(:disabled) {
    transform: translateY(1px);
  }
  .submit:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .status {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--step--2);
    line-height: 1.6;
    color: var(--ink-inverse-soft);
    min-height: 1.2em;
  }
  .status[data-tone='ok'] {
    color: var(--ink-inverse);
  }
  .status[data-tone='bad'] {
    color: var(--danger-inverse);
  }

  @media (max-width: 880px) {
    .wrap {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<!-- Turnstile's script, once for both forms (D-427). Explicitly versioned URL per Cloudflare's docs. -->
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  /**
   * Real submit handling, shared by every `[data-beta-form]` on the page —
   * Hero.astro's compact inline form as well as this section's own (D-283).
   * One handler, found generically per form. Validates with the same rule the
   * server applies (src/data/beta.ts), disables while in flight, posts the
   * fields as JSON to the form's own `action`, and reports the outcome. The
   * success message says to confirm by email, because the address is not on
   * the list until the link is clicked (D-426).
   */
  import { isValidEmail } from '../data/beta.ts';

  /** Turnstile's page API, present once its script has loaded. */
  declare global {
    interface Window {
      turnstile?: { reset(container?: Element | string): void };
    }
  }

  document.querySelectorAll<HTMLFormElement>('[data-beta-form]').forEach((form) => {
    const email = form.querySelector<HTMLInputElement>('[name="email"]');
    const err = form.querySelector<HTMLElement>('[data-err]');
    const status = form.querySelector<HTMLElement>('[data-status]');
    const button = form.querySelector<HTMLButtonElement>('[data-submit]');
    const label = form.querySelector<HTMLElement>('[data-label]');
    if (!email || !err || !status || !button || !label) return;
    const idleLabel = label.textContent ?? '';

    const setErr = (msg: string) => {
      err.textContent = msg;
      err.hidden = msg === '';
      email.setAttribute('aria-invalid', msg === '' ? 'false' : 'true');
    };

    const setStatus = (msg: string, tone: 'ok' | 'bad' | '' = '') => {
      status.textContent = msg;
      if (tone) status.dataset.tone = tone;
      else delete status.dataset.tone;
    };

    email.addEventListener('input', () => {
      if (err.hidden === false) setErr('');
    });

    form.addEventListener('submit', async (e: SubmitEvent) => {
      e.preventDefault();
      setStatus('');

      const value = email.value.trim();
      if (value === '') {
        setErr('An email address is required.');
        email.focus();
        return;
      }
      if (!isValidEmail(value)) {
        setErr('That does not look like an email address.');
        email.focus();
        return;
      }
      setErr('');

      // Turnstile adds this field when its challenge has passed. It is empty for a
      // moment after load, and when the script is blocked.
      const human = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]');
      if (!human || human.value === '') {
        setStatus('One moment while we check you are a person. Please press the button again.', 'bad');
        return;
      }

      button.disabled = true;
      label.textContent = 'Sending…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });

        if (res.ok) {
          form.reset();
          setStatus('Almost there. Check your inbox for an email from us and click the link to confirm your spot.', 'ok');
        } else if (res.status === 400) {
          setErr('That does not look like an email address.');
        } else if (res.status === 403) {
          setStatus('We could not verify you are a person. Please try again.', 'bad');
        } else {
          setStatus('That did not go through. Please try again in a moment.', 'bad');
        }
      } catch {
        setStatus('Could not reach the server. Check your connection and try again.', 'bad');
      }

      // A Turnstile token works once; get a fresh one for the next attempt.
      window.turnstile?.reset(form.querySelector('.cf-turnstile') ?? undefined);
      label.textContent = idleLabel;
      button.disabled = false;
    });
  });
</script>
