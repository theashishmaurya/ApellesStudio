---
/**
 * Beta.astro — pre-launch signup (D-255's mechanism, D-264's presentation).
 *
 * What it is: a real form with real client-side validation and real
 * submitting/success/error states, posting to Formspree's JSON endpoint. The
 * submit button is <Signature />, which makes it the one rose element on the
 * home page — this is the single action the page exists for.
 * What it does NOT do: post anywhere until the owner drops a real endpoint into
 * `src/data/beta.ts`. Until then it validates, then tells the visitor plainly
 * that signup is not open yet rather than silently swallowing an address.
 *
 * The submit logic below is deliberately unchanged by the rebrand: it worked,
 * and rewriting working infrastructure to match a new palette is churn.
 *
 * Setup: website/BETA_SIGNUP_SETUP.md.
 */
import { BETA_FORM_ENDPOINT, isPlaceholderEndpoint, ROLES } from '../data/beta.ts';
import Signature from './Signature.astro';

const endpoint = BETA_FORM_ENDPOINT;
const placeholder = isPlaceholderEndpoint(endpoint);
---

<section class="beta section" id="beta">
  <div class="shell wrap">
    <div class="copy">
      <p class="eyebrow">Pre-launch</p>
      <h2>Be there when it opens.</h2>
      <p class="lede">
        There is no public build yet. Leave an address and you will hear from us once there is one
        worth installing &mdash; that message, and nothing else.
      </p>
      <p class="fine">
        We keep your address to send you that one email. It is not sold, and there is no analytics
        or tracking script anywhere on this site.
      </p>
    </div>

    <form
      class="form"
      data-beta-form
      data-endpoint={endpoint}
      data-placeholder={placeholder ? 'true' : 'false'}
      action={endpoint}
      method="POST"
      novalidate
    >
      <div class="row">
        <label for="beta-email">Email</label>
        <input
          id="beta-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="you@example.com"
          required
          aria-describedby="beta-email-err"
        />
        <p class="err" id="beta-email-err" data-err hidden></p>
      </div>

      <div class="row">
        <label for="beta-role">What do you make? <span class="opt">optional</span></label>
        <select id="beta-role" name="role">
          <option value="">Prefer not to say</option>
          {ROLES.map((r) => <option value={r}>{r}</option>)}
        </select>
      </div>

      <!-- Honeypot: a real bot trap, visually and semantically hidden from people. -->
      <div class="hp" aria-hidden="true">
        <label for="beta-company">Company</label>
        <input id="beta-company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <Signature label="Request beta access" />

      <p class="status" data-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 1rem + 5vw, 6rem);
    align-items: start;
  }

  h2 {
    font-size: var(--step-4);
    margin: 1rem 0 1.5rem;
    font-weight: 300;
  }

  .fine {
    margin-top: 1.5rem;
    font-family: var(--font-ui);
    font-size: var(--step--2);
    line-height: 1.7;
    color: var(--pigment-basalt-soft);
    max-width: 46ch;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    border: 1px solid var(--edge-strong);
    border-radius: var(--radius-lg);
    background: var(--pigment-marble-deep);
    padding: clamp(1.25rem, 0.8rem + 1.6vw, 2rem);
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  label {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--pigment-basalt-soft);
  }

  .opt {
    font-size: var(--step--2);
    opacity: 0.75;
  }

  input[type='email'],
  select {
    width: 100%;
    background: var(--pigment-marble);
    border: 1px solid var(--edge-strong);
    border-radius: var(--radius-md);
    color: var(--pigment-basalt);
    font-family: var(--font-ui);
    font-size: var(--step-0);
    padding: 0.7rem 0.8rem;
    transition: border-color var(--dur-slow) var(--ease-out);
  }

  input[type='email']:hover,
  select:hover {
    border-color: var(--pigment-basalt-soft);
  }
  input[type='email']:focus,
  select:focus {
    border-color: var(--pigment-basalt);
  }
  input[aria-invalid='true'] {
    border-color: var(--pigment-terracotta);
  }

  .err {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--step--2);
    color: var(--pigment-terracotta);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .status {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--step--2);
    line-height: 1.6;
    color: var(--pigment-basalt-soft);
    min-height: 1.2em;
  }
  .status[data-tone='ok'] {
    color: var(--pigment-basalt);
  }
  .status[data-tone='bad'] {
    color: var(--pigment-terracotta);
  }

  @media (max-width: 880px) {
    .wrap {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  /**
   * Real submit handling. Validates, disables while in flight, reports the
   * outcome, and refuses to post at all while the endpoint is the placeholder
   * shipped in src/data/beta.ts.
   */
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  document.querySelectorAll<HTMLFormElement>('[data-beta-form]').forEach((form) => {
    const email = form.querySelector<HTMLInputElement>('#beta-email');
    const err = form.querySelector<HTMLElement>('[data-err]');
    const status = form.querySelector<HTMLElement>('[data-status]');
    const button = form.querySelector<HTMLButtonElement>('[data-submit]');
    const label = form.querySelector<HTMLElement>('[data-label]');
    if (!email || !err || !status || !button || !label) return;

    const setErr = (msg: string) => {
      err.textContent = msg;
      err.hidden = msg === '';
      email.setAttribute('aria-invalid', msg === '' ? 'false' : 'true');
    };

    const setStatus = (msg: string, tone: 'ok' | 'bad' | '' = '') => {
      status.textContent = msg;
      if (tone) status.dataset.tone = tone;
      else delete status.dataset.tone;
    };

    email.addEventListener('input', () => {
      if (err.hidden === false) setErr('');
    });

    form.addEventListener('submit', async (e: SubmitEvent) => {
      e.preventDefault();
      setStatus('');

      const value = email.value.trim();
      if (value === '') {
        setErr('An email address is required.');
        email.focus();
        return;
      }
      if (!EMAIL.test(value)) {
        setErr('That does not look like an email address.');
        email.focus();
        return;
      }
      setErr('');

      if (form.dataset.placeholder === 'true') {
        setStatus(
          'Signup is not wired up yet — this site is still pre-launch. Nothing was sent, so please try again once the form is live.',
          'bad',
        );
        return;
      }

      button.disabled = true;
      label.textContent = 'Sending…';

      try {
        const res = await fetch(form.dataset.endpoint ?? form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });

        if (res.ok) {
          form.reset();
          setStatus('You are on the list. We will be in touch when there is a build.', 'ok');
          label.textContent = 'Request beta access';
          button.disabled = false;
          return;
        }
        setStatus('That did not go through. Please try again in a moment.', 'bad');
      } catch {
        setStatus('Could not reach the server. Check your connection and try again.', 'bad');
      }

      label.textContent = 'Request beta access';
      button.disabled = false;
    });
  });
</script>
