---
/**
 * Hero.astro — the home page's single focal point (D-264, given a
 * full-bleed art panel and the page's one primary action by D-283, ink
 * instead of rose by D-284, independent headline/signup positions by D-285).
 *
 * What it is: one benefit-led headline that carries the whole value
 * proposition on its own, set directly INTO a commissioned painting of
 * Apelles himself — brush in hand, painting a filmstrip into the Greek
 * landscape. The headline (`.headline`) and the signup (`.ask`) are two
 * independently-positioned blocks, each its own percentage measured against
 * the real painting via HeroDevPanel.astro (dev-only, see its own header) —
 * dragged to their current values live, then baked in here as the real
 * `var(--dev-*, <value>)` fallbacks (D-287). That is still why `.hero` stays
 * locked to the source image's own aspect ratio (1568×1003) rather than
 * cropped with `object-fit: cover` — both blocks' positions are percentages
 * measured against the real painting, and cover-cropping would shift them at
 * every viewport width.
 * What it does NOT do: carry a product shot (this is brand art, not a
 * screenshot of the app), or highlight the headline with a mark/card
 * (D-284 tried an ochre highlighter mark behind each line; D-287 removed it
 * — plain light text with a shadow and a darker scrim reads more like a
 * headline and less like a sticky note). One typographic move survives from
 * the original design: the h1's roman-then-italic turn, on its own line via
 * a real `<br>` rather than relying on wrapping, since a wide `.headline`
 * column stopped forcing that break on its own (D-287).
 *
 * D-283 moved the page's one primary action up here from the bottom
 * (Beta.astro's own section further down keeps the same form and copy but a
 * plain button, since a page carries only one). D-284 changed what that
 * primary action looks like everywhere on the site — ink (a solid basalt
 * fill) instead of a scarce rose, see src/data/palette.ts's header comment —
 * and because Hero.astro's own ground here is dark (the painting, scrimmed),
 * the ink flips light-on-dark via a scoped override below, the same
 * inverse-context pattern D-282 established for text and hairlines on a
 * basalt section. Both this form and Beta.astro's share one submit handler
 * (Beta.astro's own script, found generically per `[data-beta-form]`).
 *
 * D-285/D-287: every hand-measured landmark value below (`.headline`'s and
 * `.ask`'s own top/left/width, `.art`'s object-position, `.scrim`'s
 * opacity) is a `var(--dev-*, <real value>)` — the fallback is what ships,
 * and HeroDevPanel.astro can override any of them live from a slider
 * instead of another round of "change a number, rebuild, screenshot,
 * repeat."
 *
 * D-287: the eyebrow line ("a video app for people who never learned to
 * edit") is gone from the headline itself — the owner's own trim, on top of
 * D-283's earlier ones. The phrase survives at the page level (index.astro's
 * own `<title>`), which is what tests/build-output.test.ts now checks
 * instead of tests/render.test.ts's old Hero-scoped assertion. Also this
 * pass: `h1`'s `font-variation-settings` reset to let `font-optical-sizing:
 * auto` (global.css, on body) pick Newsreader's actual optical cut for this
 * h1's real (small) rendered size, instead of inheriting the large-display
 * `opsz 72` global.css forces on every h1 — a mismatch that was quietly
 * making this specific headline read thinner than intended.
 */
import Signature from './Signature.astro';
import HeroDevPanel from './HeroDevPanel.astro';
import { BETA_FORM_ENDPOINT, isPlaceholderEndpoint } from '../data/beta.ts';

const endpoint = BETA_FORM_ENDPOINT;
const placeholder = isPlaceholderEndpoint(endpoint);
---

<section class="hero">
  <!-- WebP (35% smaller than the source JPG at equal visual quality) with a
       JPG fallback for browsers/tools that don't decode WebP — the JPG at
       /hero/painter.jpg stays as the one og:image/twitter:image reference
       (Base.astro), since some social-card crawlers still don't render
       WebP. -->
  <picture>
    <source srcset="/hero/painter.webp" type="image/webp" />
    <img
      class="art"
      src="/hero/painter.jpg"
      alt=""
      width="1568"
      height="1003"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="scrim" aria-hidden="true"></div>

  <!-- Roughly over the painting's own golden disc — measured, not eyeballed:
       the disc's centre sits at about 48% across, 29% down the source image. -->
  <div class="headline">
    <h1>
      You already know what your video should look like.
      <br />
      <span class="turn">Apelles is the part you were missing.</span>
    </h1>
  </div>

  <!-- Independently positioned from the headline — see this file's own
       header comment (D-285). -->
  <form
    class="ask"
    data-beta-form
    data-endpoint={endpoint}
    data-placeholder={placeholder ? 'true' : 'false'}
    action={endpoint}
    method="POST"
    novalidate
  >
    <div class="row">
      <label class="sr-only" for="hero-beta-email">Email</label>
      <input
        id="hero-beta-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        placeholder="you@example.com"
        required
        aria-describedby="hero-beta-email-err"
      />
      <Signature label="Request beta access" />
    </div>
    <p class="err" id="hero-beta-email-err" data-err hidden></p>
    <p class="status" data-status role="status" aria-live="polite"></p>

    <input type="hidden" name="_subject" value="New Apelles beta signup" />
    <!-- Honeypot: see Beta.astro's own for why `_honey` and not `_gotcha`. -->
    <div class="hp" aria-hidden="true">
      <label for="hero-beta-company">Company</label>
      <input id="hero-beta-company" name="_honey" type="text" tabindex="-1" autocomplete="off" />
    </div>
  </form>
</section>

{import.meta.env.DEV && <HeroDevPanel />}

<style>
  .hero {
    position: relative;
    overflow: hidden;
    width: 100%;
    /* Locked to the source painting's own ratio — see this file's header
       comment for why the centred column below depends on this never
       cropping. */
    aspect-ratio: 1568 / 1003;
  }

  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Tunable live from HeroDevPanel (dev-only) — see that file. */
    object-position: var(--dev-art-x, 44%) var(--dev-art-y, 46%);
  }

  /* A basalt wash — settles the painting's own colours against the rest of
     the site's palette, and (D-287, now that the headline no longer sits on
     its own highlighter mark) is the main thing making the text legible, so
     it is meaningfully darker than the original barely-there wash. Opacity
     tunable live from HeroDevPanel (dev-only). */
  .scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--pigment-basalt) var(--dev-scrim, 41%), transparent);
  }

  /* Position/size tunable live from HeroDevPanel (dev-only, stripped from
     the production build) — see that component for the actual controls.
     The var() fallbacks here are the real shipped values, so the page looks
     identical whether or not the panel ever ran. Independent of .ask below
     (D-285) — the two used to be one column; they move separately now. */
  .headline {
    position: absolute;
    left: var(--dev-headline-left, 50%);
    top: var(--dev-headline-top, 36%);
    transform: translate(-50%, -50%);
    width: var(--dev-headline-width, 44%);
    min-width: 19rem;
    text-align: center;
  }

  /* D-287: no highlighter mark behind the text any more (D-284's ochre
     `<mark>` treatment) — plain light ink instead, legible against the
     darker scrim above plus its own text-shadow. Two layers (D-287): a
     tight, near-opaque one right against the letterforms for a crisp edge
     (what actually reads as "pop" against a pale part of the painting, like
     the disc), plus the original soft wide one underneath for ambient
     contrast over busier areas. */
  h1,
  .turn {
    text-shadow:
      0 1px 3px color-mix(in srgb, var(--pigment-basalt) 92%, transparent),
      0 4px 22px color-mix(in srgb, var(--pigment-basalt) 70%, transparent);
  }

  /* global.css forces `opsz 72` (the LARGE-display optical cut) on every h1
     site-wide — right for the full-size headlines elsewhere, wrong here:
     Newsreader's optical-size axis is drawn to get sturdier, not thinner, at
     small sizes, and this h1 renders far smaller than a normal display
     headline (it has to fit inside the painted disc). Resetting it lets
     `font-optical-sizing: auto` (set on body, global.css) pick the cut that
     actually matches the real rendered size instead of a forced large one —
     this alone is most of "why does this look thin" (D-287). */
  h1 {
    font-variation-settings: normal;
    font-size: clamp(1.15rem, 0.7rem + 1.8vw, 2.15rem);
    margin: 0.6rem 0 0;
    font-weight: 480;
    line-height: 1.2;
    color: var(--ink-inverse);
  }

  /* The turn. Italic, one step down — the eye reads the claim first and the
     promise second. A real `<br>` in the markup puts it on its own line now
     (D-287) — a wide `.headline` column stopped forcing that break on its
     own once the width grew past what the main sentence needed. */
  .turn {
    display: inline-block;
    margin-top: 0.4em;
    font-style: italic;
    font-weight: 440;
    font-size: 0.76em;
    color: var(--ink-inverse-soft);
    letter-spacing: -0.012em;
  }

  /* ---- the inline ask: the page's one primary action --------------------
     Independently positioned from .headline (D-285) — its own tunable
     position/size, live from HeroDevPanel same as .headline's. */

  .ask {
    position: absolute;
    left: var(--dev-ask-left, 50%);
    top: var(--dev-ask-top, 50%);
    transform: translate(-50%, -50%);
    width: var(--dev-ask-width, 32%);
    min-width: 18rem;
    max-width: 90vw;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  /* The ink signature is dark-on-light by default (global.css), sized for a
     light — marble — ground. This hero's own ground is dark (the painting,
     scrimmed), so it flips light-on-dark here — the same inverse-context
     pattern D-282 established for text and hairlines on a basalt section. */
  .ask :global(.signature) {
    background: var(--pigment-marble);
    color: var(--pigment-basalt);
    flex: none;
    padding: 0.7rem 1.15rem;
    font-size: var(--step--1);
  }
  .ask :global(.signature:hover:not(:disabled)) {
    filter: brightness(0.96);
  }

  .ask input[type='email'] {
    flex: 1 1 10rem;
    background: var(--pigment-marble);
    border: 1px solid var(--edge-inverse-strong);
    border-radius: var(--radius-md);
    color: var(--pigment-basalt);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    padding: 0.6rem 0.75rem;
    transition: border-color var(--dur-slow) var(--ease-out);
  }
  .ask input[type='email']:hover {
    border-color: var(--pigment-marble-deep);
  }
  .ask input[type='email']:focus {
    border-color: var(--pigment-marble);
  }
  .ask input[aria-invalid='true'] {
    border-color: var(--danger-inverse);
  }

  .ask .err {
    margin: 0.5rem 0 0;
    text-align: left;
    font-family: var(--font-ui);
    font-size: var(--step--2);
    color: var(--danger-inverse);
    text-shadow: 0 1px 8px color-mix(in srgb, var(--pigment-basalt) 60%, transparent);
  }

  .ask .status {
    margin: 0.5rem 0 0;
    text-align: left;
    font-family: var(--font-ui);
    font-size: var(--step--2);
    line-height: 1.6;
    color: var(--ink-inverse-soft);
    min-height: 1.2em;
    text-shadow: 0 1px 8px color-mix(in srgb, var(--pigment-basalt) 60%, transparent);
  }
  .ask .status[data-tone='ok'] {
    color: var(--ink-inverse);
  }
  .ask .status[data-tone='bad'] {
    color: var(--danger-inverse);
  }

  .ask .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .hero :focus-visible {
    outline-color: var(--pigment-ochre);
  }

  @media (max-width: 640px) {
    /* The image's own landscape ratio (1568:1003) leaves almost no vertical
       room for two independently-positioned blocks on a narrow phone
       screen, so mobile trades the precise moon/brush landmark positioning
       for a simple minimum height instead — .headline and .ask still centre
       within whatever height that produces, just wider. */
    .hero {
      aspect-ratio: auto;
      min-height: 100vh;
    }
    .headline {
      width: 85%;
    }
    .ask {
      width: 85%;
      min-width: 0;
    }
    h1 {
      font-size: clamp(1.3rem, 1rem + 3vw, 1.8rem);
    }
    /* The image's own landscape ratio leaves no room for the full inline
       form (email input + button + err/status text) without it overlapping
       the headline above it on a real phone width — reported live, with a
       screenshot, as the two visibly colliding. Below this width the ask
       collapses to just the button; clicking it navigates to the full
       standalone Beta section (`/#beta`) instead of submitting inline — see
       this file's own <script> below, which intercepts the submit before
       Beta.astro's shared handler ever sees it. `align-items: center` (not
       the desktop layout's `stretch`) so the lone button sizes to its own
       label instead of stretching edge-to-edge across `.ask`'s 85% column —
       a full-width bar read as too heavy/not subtle here, reported live. */
    .row {
      flex-direction: column;
      align-items: center;
    }
    .ask input[type='email'],
    .ask .err,
    .ask .status {
      display: none;
    }
  }
</style>

<script>
  /**
   * Mobile only: the inline ask collapses to just the button (see the
   * `max-width: 640px` rule above) — no email input for it to submit, so a
   * click sends the visitor to the full standalone Beta section instead of
   * running Beta.astro's shared `[data-beta-form]` submit handler. Attached
   * on `.hero` (an ancestor of the form, not the form itself) and in the
   * capture phase, so it always runs before that shared handler regardless
   * of which script tag happens to execute first — capture-phase listeners
   * on an ancestor fire before same-element listeners on the target itself.
   * `stopPropagation` then keeps the event from ever reaching it.
   */
  const hero = document.querySelector('.hero');
  const isMobileAsk = () => window.matchMedia('(max-width: 640px)').matches;

  hero?.addEventListener(
    'submit',
    (event) => {
      const form = event.target;
      if (form instanceof HTMLFormElement && form.matches('[data-beta-form]') && isMobileAsk()) {
        event.preventDefault();
        event.stopPropagation();
        window.location.href = '/#beta';
      }
    },
    true,
  );
</script>
