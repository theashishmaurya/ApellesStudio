---
/**
 * Hero.astro — the home page's single focal point (D-264).
 *
 * What it is: one benefit-led headline that carries the whole value proposition
 * on its own, because most visitors read the headline and nothing else. It is
 * written from the visitor's side of the screen — what they already have (a
 * picture in their head) and what they do not (the craft) — rather than from
 * the architecture's side.
 * What it does NOT do: list features, carry a product shot, or compete with
 * itself. There is exactly one thing to read here and one place to go next; the
 * demonstration is the section below, and the ask is at the bottom of the page.
 *
 * The one typographic move on this site is in the h1: a roman first sentence
 * and an italic second one, at different sizes, doing real hierarchy work —
 * setup, then turn. Nothing else on the page is allowed a flourish.
 */
import { TOOL_TOTALS } from '../data/mcp.ts';
import { STATUS } from '../data/product.ts';

/** Three facts, each checkable elsewhere on this site. Not a feature list. */
const FACTS = [
  `Free and open source, ${STATUS.licence}`,
  'Runs on your machine, not a server',
  `${TOOL_TOTALS.shipped} real controls an agent can reach`,
];
---

<section class="hero">
  <div class="shell">
    <p class="eyebrow">A video app for people who never learned to edit</p>

    <h1>
      You already know what your video should look like.
      <span class="turn">Apelles is the part you were missing.</span>
    </h1>

    <p class="lede">
      Tell it what you are going for, in ordinary words. A real AI agent does the cutting, the
      colour and the motion graphics &mdash; the parts that normally take years to learn &mdash;
      right there on your own machine, in an app you can pick up and drive by hand whenever you
      would rather.
    </p>

    <ul class="facts">
      {FACTS.map((f) => <li>{f}</li>)}
    </ul>

    <p class="next">
      <a class="onward" href="#demo">
        See it mid-edit <span class="arrow" aria-hidden="true">&darr;</span>
      </a>
    </p>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3.5rem, 2rem + 6vw, 7.5rem);
    /* Deliberately small: the section below brings its own generous top
       padding, and stacking both left a dead band the eye had to cross. */
    padding-bottom: clamp(1rem, 0.5rem + 1vw, 1.75rem);
  }

  h1 {
    font-size: var(--step-5);
    margin: 1.5rem 0 0;
    max-width: 19ch;
    font-weight: 300;
  }

  /* The turn. Italic, one step down, and in the softened ink — so the eye reads
     the claim first and the promise second, in that order, without a rule or a
     colour or a box making it happen. */
  .turn {
    display: block;
    margin-top: 0.24em;
    font-style: italic;
    font-size: 0.62em;
    color: var(--pigment-basalt-soft);
    letter-spacing: -0.012em;
    max-width: 26ch;
  }

  .lede {
    margin-top: 2rem;
    max-width: 56ch;
  }

  .facts {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--pigment-basalt-soft);
  }

  /* An ochre tessera before each fact — the mosaic's own unit, used as a list
     mark. This is the only ornament on the page and it is 4px wide. */
  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .facts li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: var(--pigment-ochre);
    flex: none;
  }

  .next {
    margin-top: 2.75rem;
  }
  .next .arrow {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .next .onward:hover .arrow {
    transform: translateY(3px);
  }

  @media (max-width: 720px) {
    h1 {
      max-width: none;
    }
    .turn {
      font-size: 0.7em;
    }
  }
</style>
