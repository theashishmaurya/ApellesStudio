{
  "id": "particle-logo-burst",
  "name": "Particle logo burst",
  "description": "A logo word punches in while a seeded burst of particles flies out behind it and settles into a halo.",
  "tags": ["brand", "intro", "particles"],
  "props": [
    { "id": "text", "type": "text", "label": "Logo text", "default": "APELLES", "required": true, "constraints": { "minLen": 1, "maxLen": 24 } },
    { "id": "count", "type": "number", "label": "Particles", "default": 220, "constraints": { "min": 40, "max": 400, "integer": true } },
    { "id": "seed", "type": "number", "label": "Seed", "description": "Change it for a different, still deterministic, burst.", "default": 7, "constraints": { "min": 0, "max": 9999, "integer": true } },
    { "id": "spread", "type": "number", "label": "Spread (px)", "default": 560, "constraints": { "min": 120, "max": 900 } },
    { "id": "color", "type": "color", "label": "Particle colour", "description": "Unset: the theme's accent." },
    { "id": "textColor", "type": "color", "label": "Text colour", "description": "Unset: the theme's text colour." }
  ],
  "size": { "w": 1920, "h": 1080 },
  "duration": 2.5
}
