{
  "name": "chroma",
  "version": "0.0.0",
  "private": true,
  "description": "Chroma — AI-native local video tool (Edit / Motion / Colorist). Monorepo root (D-039).",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "remotion": "4.0.519",
    "@remotion/animation-utils": "4.0.519",
    "@remotion/google-fonts": "4.0.519",
    "@remotion/motion-blur": "4.0.519",
    "@remotion/noise": "4.0.519",
    "@remotion/transitions": "4.0.519",
    "@remotion/shapes": "4.0.519"
  },
  "scripts": {
    "dev": "npm run dev --workspace app",
    "build": "npm run build --workspace app",
    "tauri": "npm run tauri --workspace app --",
    "tauri:dev": "npm run start --workspace app",
    "tauri:build": "npm run tauri --workspace app -- tauri build",
    "typecheck": "npm run typecheck --workspace app"
  }
}
